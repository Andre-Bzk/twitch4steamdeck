# Eigene Twitch Application registrieren auf https://dev.twitch.tv/console/apps
# - Name: beliebig (z. B. "Twitch4SteamDeck dev")
# - OAuth Redirect URLs: http://localhost  (wird beim Device Code Flow nicht benutzt,
#   das Feld muss aber gesetzt sein)
# - Category: Application Integration
# - Client Type: Public
#
# Danach die Client-ID hier eintragen und die Datei in `.env` umbenennen.

MAIN_VITE_TWITCH_CLIENT_ID=
